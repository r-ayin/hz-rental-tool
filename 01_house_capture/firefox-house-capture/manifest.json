{
  "manifest_version": 2,
  "name": "一秒选房采集",
  "version": "1.1.0",
  "description": "在目标站点（zu.ke.com 族域名，城市可配置）批量采集租房房源：列表页批量/自动翻页、详情页保存，存入本地一秒选房服务。",
  "permissions": [
    "downloads",
    "activeTab",
    "https://*.zu.ke.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zu.ke.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ke-rental-capture@example.local"
    }
  }
}
